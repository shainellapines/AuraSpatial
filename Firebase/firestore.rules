rules_version = '2';

// AuraSpatial - Cloud Firestore security rules
// Paste this into Firebase console > Firestore Database > Rules > Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // A user's profile and private saved layouts: only that user.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /layouts/{layoutId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // The shared Community Feed.
    match /community/{postId} {
      // Any signed-in user can browse it.
      allow read: if request.auth != null;

      // You can only post as yourself.
      allow create: if request.auth != null
        && request.resource.data.creatorUID == request.auth.uid;

      // The owner can re-share (update) or remove their own post.
      allow delete: if request.auth != null
        && resource.data.creatorUID == request.auth.uid;

      // Everyone else may only change the like and fork counters.
      allow update: if request.auth != null && (
        (resource.data.creatorUID == request.auth.uid
          && request.resource.data.creatorUID == request.auth.uid)
        || request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['likeCount', 'forkCount'])
      );
    }
  }
}
